{
	"schemaVersion": 1,
	"id": "dragsimmacro",
	"version": "${version}",
	"name": "DragSimQol",
	"description": "Client-side mining and combat macros (Mining Bot, Route Walker, Zealot combat), Auto Clicker, alerts, ESP and QoL settings. Open the settings with /zealotgui.",
	"authors": [
		"gurenchang"
	],
	"contact": {
		"homepage": "https://github.com/gurenchang/DragSimQol",
		"sources": "https://github.com/gurenchang/DragSimQol"
	},
	"license": "CC0-1.0",
	"icon": "assets/dragsimmacro/icon.png",
	"environment": "*",
	"mixins": [
		{
			"config": "dragsimmacro.client.mixins.json",
			"environment": "client"
		}
	],
	"entrypoints": {
		"main": [
			"com.dragsim.macro.DragsimMacroMod"
		],
		"client": [
			"com.dragsim.macro.client.DragsimMacroClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
